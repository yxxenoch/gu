ton{min-height:38px}.panel{max-height:calc(100vh - 36px);overflow:auto;scrollbar-width:thin}.preview{position:sticky;top:18px}@media(max-width:800px){.mobile-jump{display:flex;position:sticky;top:0;z-index:10;gap:8px;padding:8px 12px;background:#ece7dc;border-bottom:1px solid #d3c9b7}.mobile-jump a{flex:1;text-align:center;padding:9px;background:#faf8f2;color:#304638;text-decoration:none;border:1px solid #c6bca9;font-size:13px}.panel{max-height:none;overflow:visible}.preview{position:static;grid-row:1}.preview-head span{display:none}.hint{font-size:12px}header p{line-height:1.6}}\n[hidden]{display:none!important}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #c6944f;outline-offset:3px}\n.app-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.app-actions button{width:auto;margin:0;background:#efe5cc;color:#263a30;border-color:#b7aa8b;font-size:12px;padding:8px 12px}.app-note{font-size:12px;line-height:1.7;color:#d3cbb6;margin-top:9px}\n.float-preview{position:fixed;right:16px;top:85px;width:320px;max-width:calc(100vw - 24px);z-index:80;background:#faf6ec;border:1px solid #8d8067;border-radius:12px;overflow:hidden;box-shadow:0 12px 42px #191b174d;contain:layout}.float-head{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:7px 9px;background:#2e4337;color:#eee7d5;touch-action:none;cursor:move;user-select:none}.float-title{font-size:12px;white-space:nowrap}.float-tools{display:flex;gap:4px}.float-head button{width:30px;min-height:30px;height:30px;margin:0;padding:0;border:1px solid #d5cdb65c;background:#ffffff0d;color:#fff;font-size:16px;border-radius:5px;cursor:pointer}.float-preview canvas{display:block;width:100%;height:auto;max-height:42vh;object-fit:contain;background:#d4c8ae;box-shadow:none}.float-footer{display:flex;justify-content:space-between;gap:8px;padding:6px 10px;font-size:10px;color:#746752}.float-footer button{width:auto;padding:2px 8px;margin:0;min-height:26px;font-size:11px;background:transparent;color:#304638;border:1px solid #c7bba3}.float-preview.collapsed .float-body{display:none}.float-reopen{position:fixed;right:14px;bottom:calc(18px + env(safe-area-inset-bottom));z-index:79;width:auto;border-radius:30px;box-shadow:0 6px 22px #17261d3d;padding:11px 18px}.font-list{display:grid;gap:5px}.font-item{display:flex;align-items:center;gap:6px;font-size:12px;padding:7px;border:1px solid #e1d8c8}.font-item span{flex:1;min-width:0;overflow-wrap:anywhere}.font-item button{width:auto;min-height:30px;margin:0;padding:4px 8px;font-size:11px;background:transparent;color:#734b37;border-color:#cfc2aa}.paper-grid{grid-template-columns:repeat(3,1fr)}.paper-grid .material-choice img{display:block;width:100%;height:62px;object-fit:cover;margin-bottom:4px}.value-row{display:flex;justify-content:space-between;gap:8px}.cache-state{font-size:11px;line-height:1.6;color:#806e4d}.panel{overscroll-behavior:contain}\n@media(max-width:800px){.preview{grid-row:auto}.float-preview{width:260px;top:75px;right:12px}.float-head{padding:6px 8px}.float-footer{padding:4px 8px}.float-title{font-size:11px}.app-actions button{flex:1}.stage{overflow:hidden}main{padding-bottom:80px}}\n\u003c/style>\u003c/head>\u003cbody>\u003cheader>\u003csmall>古折页工坊 · 在线版\u003c/small>\u003ch1>古摺頁拼圖\u003c/h1>\u003cp>將圖片收進一冊展開的古書，製作屬於你的閱讀手記。\u003c/p>\u003cdiv class=\"app-actions\">\u003cbutton id=\"installapp\">安装到手机桌面\u003c/button>\u003cbutton id=\"showfloat\">显示悬浮预览\u003c/button>\u003cbutton id=\"saveoffline\">下载单文件离线版\u003c/button>\u003c/div>\u003cdiv class=\"app-note\" id=\"appstatus\" role=\"status\">可添加到桌面；首次联网载入后，自动准备离线素材。\u003c/div>\u003c/header>\u003cnav class=\"mobile-jump\">\u003ca href=\"#preview\">查看预览\u003c/a>\u003ca href=\"#editor\">编辑与导出\u003c/a>\u003c/nav>\u003cmain>\u003csection class=\"panel\" id=\"editor\">\u003ch2>編輯你的摺頁\u003c/h2>\u003cbutton id=\"cleartext\" class=\"secondary\">一键清除本款文字\u003c/button>\u003cbutton id=\"undotext\" class=\"secondary\" hidden>撤销清除文字\u003c/button>\u003cp class=\"hint\" id=\"cleartextstatus\" role=\"status\">清除书名与四角文字，保留图片、字体和材质。\u003c/p>\u003cdiv class=\"group\">\u003clabel>上傳圖片（依選取順序排列，最多 8 張）\u003c/label>\u003cinput id=\"upload\" type=\"file\" accept=\"image/*\" multiple>\u003cdiv id=\"files\" class=\"files\">尚未上傳圖片，預覽顯示示意頁。\u003c/div>\u003cbutton id=\"clear\" class=\"secondary\">一键清空本款图片\u003c/button>\u003cbutton id=\"undo-clear\" class=\"secondary\" hidden>撤销清空\u003c/button>\u003cp class=\"hint\">包含图片、上传的封面布料与纸质；文字和字体保留。\u003c/p>\u003c/div>\u003cdiv class=\"group\">\u003clabel>封面書名\u003c/label>\u003cinput id=\"title\" type=\"text\" value=\"浮生手記\" maxlength=\"24\">\u003clabel for=\"titlesize\">书名字号\u003c/label>\u003cinput id=\"titlesize\" type=\"number\" min=\"16\" step=\"1\" value=\"56\">\u003cdetails class=\"text-settings\">\u003csummary>四角文字 · 内容、字号、字体\u003c/summary>\u003cp class=\"hint\">内容留空即可隐藏。系统字体因设备而异；可上传字体文件后分别选择。\u003c/p>\u003cfieldset>\u003clegend>左上角\u003c/legend>\u003clabel for=\"topleft\">内容\u003c/label>\u003cinput id=\"topleft\" type=\"text\" value=\"一册一景 · 慢读时光\" maxlength=\"160\">\u003cdiv class=\"text-row\">\u003cdiv>\u003clabel for=\"topleftsize\">字号\u003c/label>\u003cinput id=\"topleftsize\" type=\"number\" min=\"10\" value=\"24\">\u003c/div>\u003cdiv>\u003clabel for=\"topleftfont\">字体\u003c/label>\u003cselect id=\"topleftfont\">\u003coption value=\"serif\">宋／明朝 · 系统\u003c/option>\u003coption value=\"kai\">楷体 · 系统\u003c/option>\u003coption value=\"fangsong\">仿宋 · 系统\u003c/option>\u003coption value=\"hei\">黑体 · 系统\u003c/option>\u003c/select>\u003c/div>\u003c/div>\u003c/fieldset>\u003cfieldset>\u003clegend>右上角\u003c/legend>\u003clabel for=\"topright\">内容\u003c/label>\u003cinput id=\"topright\" type=\"text\" value=\"AN ACCORDION OF MEMORIES / 01\" maxlength=\"160\">\u003cdiv class=\"text-row\">\u003cdiv>\u003clabel for=\"toprightsize\">字号\u003c/label>\u003cinput id=\"toprightsize\" type=\"number\" min=\"10\" value=\"20\">\u003c/div>\u003cdiv>\u003clabel for=\"toprightfont\">字体\u003c/label>\u003cselect id=\"toprightfont\">\u003coption value=\"serif\">宋／明朝 · 系统\u003c/option>\u003coption value=\"kai\">楷体 · 系统\u003c/option>\u003coption value=\"fangsong\">仿宋 · 系统\u003c/option>\u003coption value=\"hei\">黑体 · 系统\u003c/option>\u003c/select>\u003c/div>\u003c/div>\u003c/fieldset>\u003cfieldset>\u003clegend>左下角\u003c/legend>\u003clabel for=\"author\">内容\u003c/label>\u003cinput id=\"author\" type=\"text\" value=\"一页一景　慢读时光\" maxlength=\"160\">\u003cdiv class=\"text-row\">\u003cdiv>\u003clabel for=\"bottomleftsize\">字号\u003c/label>\u003cinput id=\"bottomleftsize\" type=\"number\" min=\"10\" value=\"28\">\u003c/div>\u003cdiv>\u003clabel for=\"bottomleftfont\">字体\u003c/label>\u003cselect id=\"bottomleftfont\">\u003coption value=\"serif\">宋／明朝 · 系统\u003c/option>\u003coption value=\"kai\">楷体 · 系统\u003c/option>\u003coption value=\"fangsong\">仿宋 · 系统\u003c/option>\u003coption value=\"hei\">黑体 · 系统\u003c/option>\u003c/select>\u003c/div>\u003c/div>\u003c/fieldset>\u003cfieldset>\u003clegend>右下角\u003c/legend>\u003clabel for=\"bottomright\">内容\u003c/label>\u003cinput id=\"bottomright\" type=\"text\" value=\"COLLECT THE MOMENTS THAT MATTER\" maxlength=\"160\">\u003cdiv class=\"text-row\">\u003cdiv>\u003clabel for=\"bottomrightsize\">字号\u003c/label>\u003cinput id=\"bottomrightsize\" type=\"number\" min=\"10\" value=\"18\">\u003c/div>\u003cdiv>\u003clabel for=\"bottomrightfont\">字体\u003c/label>\u003cselect id=\"bottomrightfont\">\u003coption value=\"serif\">宋／明朝 · 系统\u003c/option>\u003coption value=\"kai\">楷体 · 系统\u003c/option>\u003coption value=\"fangsong\">仿宋 · 系统\u003c/option>\u003coption value=\"hei\">黑体 · 系统\u003c/option>\u003c/select>\u003c/div>\u003c/div>\u003c/fieldset>\u003c/details>\u003clabel>頁數（不含封面）\u003c/label>\u003cselect id=\"count\">\u003coption>3\u003c/option>\u003coption selected>4\u003c/option>\u003coption>5\u003c/option>\u003coption>6\u003c/option>\u003coption>7\u003c/option>\u003coption>8\u003c/option>\u003c/select>\u003clabel>圖片呈現\u003c/label>\u003cselect id=\"fit\">\u003coption value=\"cover\">填滿頁面（可能裁切）\u003c/option>\u003coption value=\"contain\">完整顯示（留白）\u003c/option>\u003c/select>\u003cdetails class=\"text-settings\">\u003csummary>折页宽高与位置\u003c/summary>\u003clabel for=\"pagewidth\">纸页宽窄（百分比）\u003c/label>\u003cinput id=\"pagewidth\" type=\"range\" min=\"60\" max=\"160\" value=\"100\">\u003clabel for=\"pageheight\">纸页高度（百分比）\u003c/label>\u003cinput id=\"pageheight\" type=\"range\" min=\"60\" max=\"150\" value=\"100\">\u003clabel for=\"bookoffset\">书册上下位置\u003c/label>\u003cinput id=\"bookoffset\" type=\"range\" min=\"-15\" max=\"15\" value=\"0\">\u003cp class=\"hint\">宽高可分别调整，超出画布时整册会按比例缩小。\u003c/p>\u003c/details>\u003clabel>摺痕深度\u003c/label>\u003cinput id=\"fold\" type=\"range\" min=\"0\" max=\"100\" value=\"55\">\u003clabel>畫布比例\u003c/label>\u003cselect id=\"ratio\">\u003coption value=\"land\">橫式 3:2\u003c/option>\u003coption value=\"square\">方形 1:1\u003c/option>\u003coption value=\"portrait\">直式 4:5\u003c/option>\u003c/select>\u003clabel>桌面材質\u003c/label>\u003cselect id=\"theme\">\u003coption value=\"wood\">深色木案\u003c/option>\u003coption value=\"lightwood\">淺色木案\u003c/option>\u003coption value=\"bamboo\">竹席 · 密编细篾\u003c/option>\u003coption value=\"bambooscreen\">竹帘 · 疏排穿绳\u003c/option>\u003coption value=\"gauze\">素色紗布\u003c/option>\u003coption value=\"paper\">宣紙米白\u003c/option>\u003c/select>\u003clabel for=\"covercolor\">融合时使用的封面颜色\u003c/label>\u003cselect id=\"covercolor\">\u003coption value=\"#293f33\">黛綠\u003c/option>\u003coption value=\"#833e34\">磚紅\u003c/option>\u003coption value=\"#263b43\">鴉青\u003c/option>\u003coption value=\"#45404f\">黛紫\u003c/option>\u003coption value=\"#826b4b\">茶褐\u003c/option>\u003c/select>\u003cdiv class=\"row\" style=\"margin-top:12px\">\u003clabel for=\"cover-custom\">自定义封面色\u003c/label>\u003cinput id=\"cover-custom\" type=\"color\" value=\"#293f33\">\u003c/div>\u003clabel for=\"fabric\">封面布料 · 八款内置素材\u003c/label>\u003cselect id=\"fabric\">\u003coption value=\"sample1\">1 · 黛青旧织\u003c/option>\u003coption value=\"sample2\">2 · 米黄旧织\u003c/option>\u003coption value=\"sample3\">3 · 赭褐旧织\u003c/option>\u003coption value=\"sample4\">4 · 朱红团花锦\u003c/option>\u003coption value=\"sample5\">5 · 赭金团花锦\u003c/option>\u003coption value=\"sample6\">6 · 金黄织锦\u003c/option>\u003coption value=\"sample7\">7 · 黛褐蓝花锦\u003c/option>\u003coption value=\"sample8\">8 · 灰绿粗麻\u003c/option>\u003coption value=\"linen\">素织 · 原有细麻效果\u003c/option>\u003coption value=\"coarse\">素织 · 原有粗麻效果\u003c/option>\u003coption value=\"silk\">素锦 · 原有效果\u003c/option>\u003coption value=\"brocade\">花锦 · 原有效果\u003c/option>\u003coption value=\"uploaded\">我上传的布料\u003c/option>\u003c/select>\u003cdiv id=\"materials\" class=\"material-grid\" aria-label=\"八款布料预览\">\u003c/div>\u003clabel for=\"fabricblend\">布料与封面颜色\u003c/label>\u003cselect id=\"fabricblend\">\u003coption value=\"original\">不融合 · 保留布料原色\u003c/option>\u003coption value=\"tint\">叠加颜色 · 自定义深浅\u003c/option>\u003c/select>\u003clabel for=\"tintstrength\">颜色图层深浅 \u003coutput id=\"tintvalue\">20%\u003c/output>\u003c/label>\u003cinput id=\"tintstrength\" type=\"range\" min=\"0\" max=\"100\" value=\"20\">\u003cp class=\"hint\">0% 保留原色；20% 为轻染。拉高会加深染色，同时保留布纹明暗。\u003c/p>\u003clabel for=\"fabricfile\">上传自己的布料（可选）\u003c/label>\u003cinput id=\"fabricfile\" type=\"file\" accept=\"image/*\">\u003cp id=\"fabricstatus\" class=\"material-status\" aria-live=\"polite\">八款素材已内置，无需再次上传。\u003c/p>\u003cdetails class=\"text-settings\" open>\u003csummary>折页纸质 · 九款实物素材\u003c/summary>\u003clabel for=\"papermaterial\">纸质素材\u003c/label>\u003cselect id=\"papermaterial\">\u003coption value=\"classic\">原有 · 微黄竹纤维纸\u003c/option>\u003coption value=\"leaf1\" selected>1 · 米白细纤维\u003c/option>\u003coption value=\"leaf2\">2 · 花瓣手工纸\u003c/option>\u003coption value=\"leaf3\">3 · 茶染旧宣\u003c/option>\u003coption value=\"leaf4\">4 · 浅黄长纤维\u003c/option>\u003coption value=\"leaf5\">5 · 本白皱纹纸\u003c/option>\u003coption value=\"leaf6\">6 · 淡粉草纤维\u003c/option>\u003coption value=\"leaf7\">7 · 斑驳旧笺\u003c/option>\u003coption value=\"leaf8\">8 · 青灰刷纹\u003c/option>\u003coption value=\"leaf9\">9 · 朱砂洒金\u003c/option>\u003coption value=\"uploaded\">我上传的纸质\u003c/option>\u003c/select>\u003cdiv id=\"papermaterials\" class=\"material-grid paper-grid\" aria-label=\"九款纸质预览\">\u003c/div>\u003clabel for=\"paperstrength\">图片上的纸纹强度 \u003coutput id=\"paperstrengthvalue\">38%\u003c/output>\u003c/label>\u003cinput id=\"paperstrength\" type=\"range\" min=\"0\" max=\"100\" value=\"38\">\u003cp class=\"hint\">页边使用所选纸质；此滑杆控制纸纹在图片上的叠加强度，0% 保留图片原色。\u003c/p>\u003clabel for=\"paperfile\">上传自定义纸质\u003c/label>\u003cinput id=\"paperfile\" type=\"file\" accept=\"image/*\">\u003cp id=\"paperstatus\" class=\"material-status\" role=\"status\">九款素材已内置，可直接切换。\u003c/p>\u003c/details>\u003clabel for=\"scrap\">左下角舊紙貼片\u003c/label>\u003cselect id=\"scrap\">\u003coption value=\"mix\">墨书、朱栏混搭包角\u003c/option>\u003coption value=\"manuscript\">泛黄墨书包角\u003c/option>\u003coption value=\"ruled\">朱栏旧笺包角\u003c/option>\u003coption value=\"none\">不贴碎纸\u003c/option>\u003c/select>\u003clabel for=\"papercount\">包角贴片数量\u003c/label>\u003cselect id=\"papercount\">\u003coption>3\u003c/option>\u003coption selected>4\u003c/option>\u003coption>5\u003c/option>\u003c/select>\u003clabel for=\"paperage\">旧纸与纤维强度\u003c/label>\u003cinput id=\"paperage\" type=\"range\" min=\"0\" max=\"100\" value=\"75\">\u003clabel for=\"boardthickness\">硬殼厚度 \u003coutput id=\"thicknessvalue\">薄\u003c/output>\u003c/label>\u003cinput id=\"boardthickness\" type=\"range\" min=\"1\" max=\"6\" step=\"0.5\" value=\"2.5\">\u003clabel>書名字體\u003c/label>\u003cselect id=\"font\">\u003coption value=\"serif\">宋／明朝 · 系统\u003c/option>\u003coption value=\"kai\">楷体 · 系统\u003c/option>\u003coption value=\"fangsong\">仿宋 · 系统\u003c/option>\u003coption value=\"hei\">黑体 · 系统\u003c/option>\u003c/select>\u003clabel>上傳字體（可選，TTF / OTF / WOFF）\u003c/label>\u003cinput id=\"fontfile\" type=\"file\" multiple accept=\".ttf,.otf,.woff,.woff2\">\u003cp id=\"fontstatus\" cla